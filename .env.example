# 仅为环境变量清单，不自动加载此文件，不在这里填写密钥。
FITLIFE_PROVIDER=modelflare
FITLIFE_BASE_URL=https://modelflare.dev/v1
FITLIFE_MODEL=gpt-5.6-sol
FITLIFE_KEY_ENV=MODELFLARE_API_KEY
# 只有平台/模型明确支持且验收通过时才设置推理强度。
# FITLIFE_REASONING_EFFORT=low

# MySQL：默认测试环境，账号/库按环境固定配对；密码由本机隐藏输入或进程环境提供。
FITLIFE_DB_ENVIRONMENT=test
FITLIFE_DB_HOST=127.0.0.1
FITLIFE_DB_PORT=3306
# 不在本文件填写FITLIFE_DB_PASSWORD。

# Redis：环境跟随数据库，开发DB2/测试DB3，不能自行指定其他DB；密码仍从安全配置取。
FITLIFE_REDIS_HOST=127.0.0.1
FITLIFE_REDIS_PORT=6379
FITLIFE_REDIS_CAPACITY=2
# FITLIFE_REDIS_CREDENTIALS_FILE=E:/Work/Config/Redis/.env

# 挂载secret时仅设置文件路径，不在项目文件写秘密。
# FITLIFE_DB_PASSWORD_FILE=/run/secrets/mysql_password
# FITLIFE_REDIS_PASSWORD_FILE=/run/secrets/redis_password
# FITLIFE_KEY_FILE=/run/secrets/model_key

# 有界执行；未知平台费用不作金额承诺。
FITLIFE_MAX_STEPS=4
FITLIFE_MAX_MODEL_CALLS=6
FITLIFE_MAX_TOOL_CALLS=4
FITLIFE_MODEL_RETRIES=1
FITLIFE_READONLY_TOOL_RETRIES=1
FITLIFE_READONLY_CONCURRENCY=2
FITLIFE_RUN_TIMEOUT=100
FITLIFE_REQUEST_TIMEOUT=45
FITLIFE_TOOL_TIMEOUT=10
FITLIFE_MAX_INPUT_BYTES=60000
FITLIFE_MAX_TOTAL_TOKEN_UNITS=128000


# 0.5：以下主从预算由整个请求共享，不给每个子Agent各复制一份。
FITLIFE_ORCHESTRATION=master
FITLIFE_ROUTING_POLICY=conservative
FITLIFE_ROUTER_MODEL=fast
FITLIFE_EASY_MODEL=fast
FITLIFE_VISION_MODEL=vision
FITLIFE_MASTER_MAX_STEPS=16
FITLIFE_MASTER_MAX_MODEL_CALLS=12
FITLIFE_MASTER_MAX_TOOL_CALLS=12
FITLIFE_MASTER_RUN_TIMEOUT=240
FITLIFE_MASTER_TOKEN_UNITS=350000
# 自定义多平台/本地协议时使用无秘密的注册表；key_env/key_file仅引用安全凭据来源。
# FITLIFE_MODEL_PROFILES_FILE=H:/Tomorrow/FitLife/config/models.local.json

# 模型可靠执行：当前默认值。关闭本地备用可将FITLIFE_FALLBACK_PROFILE设为空字符串。
FITLIFE_CIRCUIT_ENABLED=true
FITLIFE_CIRCUIT_FAILURE_THRESHOLD=2
FITLIFE_CIRCUIT_COOLDOWN=30
FITLIFE_FALLBACK_PROFILE=local
# 每个模型配置也可指定request_timeout。规则/平台示例都不含密钥；用之前先按文档设置。
# FITLIFE_ROUTING_POLICY=rules
# FITLIFE_ROUTING_RULES_FILE=H:/Tomorrow/FitLife/config/routing.example.json
# FITLIFE_MODEL_PROFILES_FILE=H:/Tomorrow/FitLife/config/openrouter.models.example.json
# OpenRouter密钥仅从进程环境OPENROUTER_API_KEY读取，隐藏输入步骤见docs/model-resilience.md。

# 免费验收使用专用配置：各云配置free_only=true，仅:free+0价上限，无付费回退。
# FITLIFE_MODEL_PROFILES_FILE=H:/Tomorrow/FitLife/config/openrouter.free.models.json
# FITLIFE_ROUTING_RULES_FILE=H:/Tomorrow/FitLife/config/openrouter.free.routing.json
# 验收命令python -m fitlife.openrouter_check --live-free；不会自动加载此文件。

# 硅基流动本机入口scripts/start_siliconflow.ps1读取已有SILI_API_KEY用户变量，无须写入本文件。
# FITLIFE_MODEL_PROFILES_FILE=H:/Tomorrow/FitLife/config/siliconflow.models.json
# 模型配置可显式声明enable_thinking及thinking_budget；不等同于reasoning_effort。
